# PostgreSQL
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/event_ticketing

# Generate a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Local seed accounts only; never reuse a real password.
SEED_PASSWORD=replace-with-a-local-only-password

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
